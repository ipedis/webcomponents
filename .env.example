# Configuration of the demo SSR server (apps/demo/server/config.ts).
# Copy this file to .env for local development: `cp .env.example .env`.
# An empty or missing variable keeps its default, which is the production value.
# Variables already set in the environment take precedence over this file.

# Port and interface the Node server listens on (npm run demo:ssr).
# PORT=4000
# IP=0.0.0.0

# Path prefix the app is served under. Must match `baseHref` in
# apps/demo/project.json, which is fixed at build time.
# BASE_PATH=/webcomponents

# Design system site: "back" links, home redirects and CSP frame-ancestors.
# DESIGN_SYSTEM_URL=https://design.ipedis.com

# Matomo analytics. Disabled locally so development visits are not tracked.
MATOMO_ENABLED=false
# MATOMO_URL=https://ipedis.matomo.cloud
# MATOMO_SITE_ID=71

# Extra hosts accepted by Angular SSR (comma-separated), added to localhost and
# *.ipedis.com from apps/demo/project.json. Read by Angular itself.
# NG_ALLOWED_HOSTS=127.0.0.1
