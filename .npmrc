# Temporary: the Nx 23.1.0-beta prerelease trips npm's strict peer-dependency
# semver (@nx/devkit peers `nx@">= 22 <= 24 || ^23.0.0-0"`, which excludes the
# `23.1.0-beta.x` prerelease). Remove this line once Nx ships a stable 23.1.0
# with Angular 22 support and the beta pins in package.json are dropped.
legacy-peer-deps=true
