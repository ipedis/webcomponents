{
  "name": "ipedis",
  "version": "1.0.0",
  "license": "CC0-1.0",
  "homepage": "https://github.com/docaxess/webcomponents",
  "bugs": {
    "url": "https://github.com/docaxess/webcomponents/issues",
    "email": "hi@docaxess.com"
  },
  "scripts": {
    "nx": "nx",
    "lint:update": "prettier *.json --write && nx run-many --target=lint --all --fix",
    "build": "nx run-many --target=build --all --projects=tag:type:webcomponent && nx run demo:build:production",
    "lint": "nx run-many --target=lint --all",
    "e2e": "nx run-many --target=e2e --all --exclude=demo",
    "test": "nx run-many --target=test --all",
    "demo:ssr": "nx run demo:build:production && node dist/demo/server/server.mjs",
    "migrate": "nx migrate latest && nx migrate --run-migrations --if-exists",
    "run:ci": "npm run lint && npm run test && npm run e2e && npm run build",
    "serve": "nx serve demo",
    "full": "npm run lint && npm run test && npm run e2e && npm run build"
  },
  "private": false,
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.3",
