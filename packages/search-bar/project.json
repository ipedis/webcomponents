{
  "name": "search-bar",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/search-bar/src",
  "projectType": "library",
  "tags": ["type:webcomponent"],
  "generators": {
    "@nxext/stencil:component": {
      "style": "scss"
    }
  },
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/search-bar/jest.config.js"
      }
    },
    "build": {
      "executor": "@nxext/stencil:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/search-bar/tsconfig.lib.json",
        "configPath": "packages/search-bar/stencil.config.ts",
        "outputPath": "dist/packages/search-bar"
      },
      "configurations": {
        "production": {
          "dev": false,
          "prod": true
        }
      }
    },
    "serve": {
      "executor": "@nxext/stencil:serve",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/search-bar/tsconfig.lib.json",
        "configPath": "packages/search-bar/stencil.config.ts",
        "outputPath": "dist/packages/search-bar"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/packages/search-bar/playwright-report"],
      "options": {
        "config": "packages/search-bar/playwright.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/search-bar/src/**/*.{ts,tsx,json}",
          "packages/search-bar/*.{ts,tsx,json}"
        ]
      }
    }
  }
}
