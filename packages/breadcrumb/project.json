{
  "name": "breadcrumb",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/breadcrumb/src",
  "projectType": "library",
  "tags": ["type:webcomponent"],
  "generators": {
    "@nxext/stencil:component": {
      "style": "scss"
    }
  },
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/breadcrumb/jest.config.js"
      }
    },
    "build": {
      "executor": "@nxext/stencil:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/breadcrumb/tsconfig.lib.json",
        "configPath": "packages/breadcrumb/stencil.config.ts",
        "outputPath": "dist/packages/breadcrumb"
      },
      "configurations": {
        "production": {
          "dev": false,
          "prod": true
        }
      }
    },
    "serve": {
      "executor": "@nxext/stencil:serve",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/breadcrumb/tsconfig.lib.json",
        "configPath": "packages/breadcrumb/stencil.config.ts",
        "outputPath": "dist/packages/breadcrumb"
      }
    },
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": ["{workspaceRoot}/packages/breadcrumb/playwright-report"],
      "options": {
        "config": "packages/breadcrumb/playwright.config.ts"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
