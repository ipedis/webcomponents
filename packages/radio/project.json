{
  "name": "radio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/radio/src",
  "projectType": "library",
  "tags": ["type:webcomponent"],
  "generators": {
    "@nxext/stencil:component": {
      "style": "scss"
    }
  },
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/jest.preset.js",
        {
          "externalDependencies": [
            "jest",
            "jest-stencil-runner",
            "@stencil/core"
          ]
        }
      ],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    },
    "build": {
      "executor": "@nxext/stencil:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/radio/tsconfig.lib.json",
        "configPath": "packages/radio/stencil.config.ts",
        "outputPath": "dist/packages/radio"
      },
      "configurations": {
        "production": {
          "dev": false,
          "prod": true
        }
      }
    },
    "serve": {
      "executor": "@nxext/stencil:serve",
      "outputs": ["{options.outputPath}"],
      "options": {
        "projectType": "library",
        "tsConfig": "packages/radio/tsconfig.lib.json",
        "configPath": "packages/radio/stencil.config.ts",
        "outputPath": "dist/packages/radio"
      }
    },
    "e2e": {
      "outputs": ["{workspaceRoot}/packages/radio/playwright-report"]
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    }
  }
}
